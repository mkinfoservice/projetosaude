# ===========================================
# CONCESSIONARIA INTELIGENTE BEM — .env.example
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# ===========================================

# --- BANCO DE DADOS (Locaweb MySQL) ---
DB_HOST=seu_host.mysql.dbaas.com.br
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASS=sua_senha_aqui
DB_CHARSET=utf8mb4
DB_PORT=3306

# --- CONFIGURAÇÕES DA APLICAÇÃO ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seudominio.com.br
APP_SECRET=gere_uma_chave_aleatoria_de_64_chars

# --- ASAAS API (Pagamentos PIX) ---
# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=SUA_API_KEY_ASAAS_AQUI
ASAAS_WEBHOOK_TOKEN=gere_um_token_aleatorio_para_webhook

# --- DADOS PIX DA EMPRESA ---
EMPRESA_CNPJ=00.000.000/0001-00
EMPRESA_NOME=NOME DA EMPRESA LTDA
EMPRESA_BANCO=461
EMPRESA_AGENCIA=0001
EMPRESA_CONTA=0000000-0

# --- SESSÃO ---
SESSION_LIFETIME=3600

# --- UPLOADS ---
UPLOAD_MAX_SIZE_MB=10
UPLOAD_PATH=../storage/uploads/

# --- LOGS ---
LOG_ENABLED=true
LOG_PATH=../storage/logs/
